#!/usr/bin/env bash
# Blocks commits that expose personal identifiers.
#
# Identity resolution (mirrors git's own order):
#   1. GIT_COMMITTER_* / GIT_AUTHOR_* env vars
#   2. git config user.name / user.email
#   3. OS fallback (%USERNAME%@%USERDOMAIN% or whoami@hostname)
#      — only checked when git config is unset
#
# Staged file content is also scanned.
# Files under .githooks/ are never scanned (pattern definitions live there).
#
# Activate with: git config core.hooksPath .githooks

_F="$(git rev-parse --show-toplevel)/.githooks/blocked-patterns"

if [ ! -f "$_F" ]; then
  printf 'pre-commit: %s not found — skipping restricted-identifier check.\n' "$_F" >&2
  printf '  Copy .githooks/blocked-patterns.example → .githooks/blocked-patterns and fill it in.\n' >&2
  exit 0
fi

# Resolve the full identity chain git would use for this commit.
_EMAIL="${GIT_COMMITTER_EMAIL:-${GIT_AUTHOR_EMAIL:-$(git config user.email 2>/dev/null)}}"
_NAME="${GIT_COMMITTER_NAME:-${GIT_AUTHOR_NAME:-$(git config user.name 2>/dev/null)}}"

# OS-level fallback — only relevant when git config is unset.
_OS_USER="${USERNAME:-${USER:-}}"
_OS_DOMAIN="${USERDOMAIN:-$(hostname 2>/dev/null)}"

if [ -z "$_EMAIL" ]; then
  printf '\nCommit blocked: no git user.email configured.\n' >&2
  printf '  Without an explicit identity git uses OS username@hostname (%s@%s).\n' "$_OS_USER" "$_OS_DOMAIN" >&2
  if printf '%s\n%s' "$_OS_USER" "$_OS_DOMAIN" | grep -qIEf "$_F" 2>/dev/null; then
    printf '  OS identity matches a restricted pattern — would leak if used.\n' >&2
  fi
  printf '  Fix: git config user.email "<your-email>"\n' >&2
  exit 1
fi

if printf '%s\n%s' "$_EMAIL" "$_NAME" | grep -qIEf "$_F" 2>/dev/null; then
  printf '\nCommit blocked: committer identity matches a restricted pattern.\n' >&2
  printf '  Source: git config or GIT_AUTHOR_EMAIL / GIT_COMMITTER_EMAIL env vars.\n' >&2
  printf '  Fix:    git config user.email "<your-email>"\n' >&2
  exit 1
fi

_STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
[ -z "$_STAGED" ] && exit 0

_FOUND=0
while IFS= read -r _f; do
  [ -z "$_f" ] && continue
  # Never scan files under .githooks/ — pattern definitions live there.
  case "$_f" in
    .githooks/*) continue ;;
  esac

  _CONTENT=$(git show ":$_f" 2>/dev/null) || continue

  if printf '%s' "$_CONTENT" | grep -qIEf "$_F"; then
    printf 'BLOCKED  %s\n' "$_f" >&2
    _FOUND=1
  fi
done <<< "$_STAGED"

if [ "$_FOUND" -eq 1 ]; then
  printf '\nCommit blocked: staged files match a restricted pattern in %s\n' "$_F" >&2
  printf 'Remove the restricted content and try again.\n' >&2
  exit 1
fi

exit 0
