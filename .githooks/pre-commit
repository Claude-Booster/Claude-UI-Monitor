#!/usr/bin/env bash
# Pre-commit: blocks commits containing patterns defined in .githooks/blocked-patterns
# That file is gitignored — copy blocked-patterns.example to blocked-patterns and fill it in.
# Activate: git config core.hooksPath .githooks

SELF=".githooks/pre-commit"
PATTERNS=".githooks/blocked-patterns"

if [ ! -f "$PATTERNS" ]; then
  printf 'pre-commit: %s not found — skipping restricted-identifier check.\n' "$PATTERNS" >&2
  printf '  Copy .githooks/blocked-patterns.example → .githooks/blocked-patterns and add your patterns.\n' >&2
  exit 0
fi

# Check committer identity against blocked patterns
COMMITTER_EMAIL=$(git config user.email 2>/dev/null)
COMMITTER_NAME=$(git config user.name 2>/dev/null)
if printf '%s\n%s' "$COMMITTER_EMAIL" "$COMMITTER_NAME" | grep -qIEf "$PATTERNS" 2>/dev/null; then
  printf '\nCommit blocked: git user.email or user.name matches a restricted pattern.\n' >&2
  printf '  Run: git config user.email "you@example.com"  (use a non-work address)\n' >&2
  exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
[ -z "$STAGED" ] && exit 0

FOUND=0
while IFS= read -r f; do
  [ -z "$f" ]          && continue
  [ "$f" = "$SELF" ]   && continue   # never scan this hook file itself
  [ "$f" = "$PATTERNS" ] && continue # never scan the patterns file itself

  CONTENT=$(git show ":$f" 2>/dev/null) || continue

  if printf '%s' "$CONTENT" | grep -qIEf "$PATTERNS"; then
    printf 'BLOCKED  %s\n' "$f" >&2
    FOUND=1
  fi
done <<< "$STAGED"

if [ "$FOUND" -eq 1 ]; then
  printf '\nCommit blocked: staged files match a restricted pattern in %s\n' "$PATTERNS" >&2
  printf 'Remove the restricted content and try again.\n' >&2
  exit 1
fi

exit 0
