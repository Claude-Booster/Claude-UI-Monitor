#!/bin/sh
# Blocks commit messages containing restricted identifiers.
# Also validates commit identity (belt-and-suspenders alongside pre-commit).
#
# Covers: git commit, git commit --amend, git cherry-pick, git merge, git rebase
#
# Activate with: git config core.hooksPath .githooks

_F="$(git rev-parse --show-toplevel)/.githooks/blocked-patterns"
_M="$1"

[ ! -f "$_F" ] && exit 0
[ ! -f "$_M" ] && exit 0

_P=""
while IFS= read -r _l; do
    _l=$(printf '%s' "$_l" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$_l" in
        ''|\#*) continue ;;
    esac
    if [ -z "$_P" ]; then
        _P="$_l"
    else
        _P="$_P\|$_l"
    fi
done < "$_F"

[ -z "$_P" ] && exit 0

# Guard 1: commit message content
if grep -q "$_P" "$_M"; then
    echo "ERROR: Commit message contains a restricted identifier."
    echo "Edit the message before committing."
    exit 1
fi

# Guard 2: env var identity
_ENV="${GIT_AUTHOR_NAME:-} ${GIT_AUTHOR_EMAIL:-} ${GIT_COMMITTER_NAME:-} ${GIT_COMMITTER_EMAIL:-}"
if printf '%s' "$_ENV" | grep -iq "$_P"; then
    echo "ERROR: A restricted identifier is set in a GIT_AUTHOR_* or GIT_COMMITTER_* env var."
    echo "Fix: unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL"
    exit 1
fi

# Guard 3: git config identity
_CFG_NAME="$(git config user.name 2>/dev/null)"
_CFG_EMAIL="$(git config user.email 2>/dev/null)"

if printf '%s' "$_CFG_NAME $_CFG_EMAIL" | grep -iq "$_P"; then
    echo "ERROR: git config user.name or user.email contains a restricted identifier."
    printf '  user.name  = %s\n' "${_CFG_NAME:-<unset>}"
    printf '  user.email = %s\n' "${_CFG_EMAIL:-<unset>}"
    echo "Fix: git config user.name '<your-name>' && git config user.email '<your-email>'"
    exit 1
fi

# Guard 4: OS fallback — only when git config is unset
if [ -z "$_CFG_NAME" ] || [ -z "$_CFG_EMAIL" ]; then
    _OS="$(whoami 2>/dev/null || id -un 2>/dev/null || printf '%s' "${USERNAME:-}") $(hostname 2>/dev/null || printf '%s' "${COMPUTERNAME:-}") ${USERDOMAIN:-}"
    if printf '%s' "$_OS" | grep -iq "$_P"; then
        echo "ERROR: git config is unset and the OS identity contains a restricted identifier."
        echo "Fix: git config user.name '<your-name>' && git config user.email '<your-email>'"
        exit 1
    fi
fi

exit 0
