#!/bin/sh
# Block pushes that would expose personal identifiers in:
#   - annotated tag tagger header (name + email embedded in the tag object)
#   - annotated tag message body
#   - commit author / committer identities in the pushed commit range
#
# Note: git tag -a has no pre-tag hook — this pre-push check is the only
# client-side gate for annotated tags.
#
# Activate with: git config core.hooksPath .githooks

BLOCKED_FILE="$(git rev-parse --show-toplevel)/.githooks/blocked-patterns"

if [ ! -f "$BLOCKED_FILE" ]; then
    exit 0
fi

FORBIDDEN=""
while IFS= read -r line; do
    line=$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$line" in
        ''|\#*) continue ;;
    esac
    if [ -z "$FORBIDDEN" ]; then
        FORBIDDEN="$line"
    else
        FORBIDDEN="$FORBIDDEN\|$line"
    fi
done < "$BLOCKED_FILE"

if [ -z "$FORBIDDEN" ]; then
    exit 0
fi

FAILED=0

# stdin: <local-ref> <local-sha1> <remote-ref> <remote-sha1>
while read -r local_ref local_sha remote_ref remote_sha; do

    # Skip deletes
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    obj_type=$(git cat-file -t "$local_sha" 2>/dev/null)

    if [ "$obj_type" = "tag" ]; then
        # ── Annotated tag: check the FULL raw object ───────────────────
        # The raw object contains:
        #   object <sha>
        #   type commit
        #   tag <name>
        #   tagger Name <email> <timestamp>    ← personal identity lives here
        #   <blank line>
        #   <message body>
        raw_tag=$(git cat-file tag "$local_sha" 2>/dev/null)

        if printf '%s' "$raw_tag" | grep -iq "$FORBIDDEN"; then
            echo "ERROR: Annotated tag contains blocked identifiers."
            printf '  Tag ref: %s\n' "$remote_ref"

            tagger_line=$(printf '%s' "$raw_tag" | grep "^tagger ")
            tag_body=$(printf '%s' "$raw_tag" | sed '1,/^$/d')

            if printf '%s' "$tagger_line" | grep -iq "$FORBIDDEN"; then
                printf '  Tagger:  %s\n' "$tagger_line"
                echo "  (blocked identifier in tagger name or email)"
            fi
            if printf '%s' "$tag_body" | grep -iq "$FORBIDDEN"; then
                echo "  (blocked identifier in tag message body)"
            fi

            tag_name=$(printf '%s' "$remote_ref" | sed 's|refs/tags/||')
            echo ""
            echo "Delete and recreate with a clean identity:"
            printf '  git tag -d %s\n' "$tag_name"
            printf '  git config user.name  "Developer"\n'
            printf '  git config user.email "fredman08@users.noreply.github.com"\n'
            printf '  git tag -a %s -m "your message"\n' "$tag_name"
            FAILED=1
        fi

    else
        # ── Commit range: check author + committer identities ──────────
        # Determine the range of commits being pushed.
        # remote_sha = zeros means the remote branch doesn't exist yet.
        if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
            commit_range="$local_sha"
        else
            commit_range="${remote_sha}..${local_sha}"
        fi

        # %an = author name, %ae = author email
        # %cn = committer name, %ce = committer email
        bad=$(git log --format="%H  author: %an <%ae>  committer: %cn <%ce>" \
                "$commit_range" 2>/dev/null \
            | grep -i "$FORBIDDEN")

        if [ -n "$bad" ]; then
            echo "ERROR: Pushed commits contain blocked identifiers in author/committer identity:"
            printf '%s\n' "$bad" | while IFS= read -r entry; do
                printf '  %s\n' "$entry"
            done
            echo ""
            echo "Rewrite history to fix the identity, then retry:"
            echo "  git config user.name  'Developer'"
            echo "  git config user.email 'fredman08@users.noreply.github.com'"
            echo "  git rebase -i <base-sha>  # recommit with corrected identity"
            FAILED=1
        fi
    fi

done

exit $FAILED
