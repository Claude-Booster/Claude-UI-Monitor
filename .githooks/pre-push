#!/bin/sh
# Blocks pushes that expose restricted identifiers in:
#   - commit author / committer identities in the pushed commit range
#   - annotated tag tagger header and message body
#
# git tag -a has no pre-tag hook; this is the only client-side gate for tags.
#
# Activate with: git config core.hooksPath .githooks

_F="$(git rev-parse --show-toplevel)/.githooks/blocked-patterns"

[ ! -f "$_F" ] && exit 0

_P=""
while IFS= read -r _l; do
    _l=$(printf '%s' "$_l" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$_l" in
        ''|\#*) continue ;;
    esac
    if [ -z "$_P" ]; then
        _P="$_l"
    else
        _P="$_P\|$_l"
    fi
done < "$_F"

[ -z "$_P" ] && exit 0

_FAILED=0

while read -r _lref _lsha _rref _rsha; do
    [ "$_lsha" = "0000000000000000000000000000000000000000" ] && continue

    _type=$(git cat-file -t "$_lsha" 2>/dev/null)

    if [ "$_type" = "tag" ]; then
        # Annotated tag: scan full raw object (tagger name+email + message body)
        _raw=$(git cat-file tag "$_lsha" 2>/dev/null)

        if printf '%s' "$_raw" | grep -iq "$_P"; then
            echo "ERROR: Annotated tag contains a restricted identifier."
            printf '  Tag ref: %s\n' "$_rref"

            _tagger=$(printf '%s' "$_raw" | grep "^tagger ")
            _body=$(printf '%s' "$_raw" | sed '1,/^$/d')

            if printf '%s' "$_tagger" | grep -iq "$_P"; then
                printf '  Tagger:  %s\n' "$_tagger"
            fi
            if printf '%s' "$_body" | grep -iq "$_P"; then
                echo "  (restricted identifier in tag message)"
            fi

            _tname=$(printf '%s' "$_rref" | sed 's|refs/tags/||')
            echo ""
            echo "Delete and recreate the tag with a clean identity:"
            printf '  git tag -d %s\n' "$_tname"
            echo '  git config user.name  "<your-name>"'
            echo '  git config user.email "<your-email>"'
            printf '  git tag -a %s -m "<message>"\n' "$_tname"
            _FAILED=1
        fi

    else
        # Commit range: check author + committer identities for every pushed commit
        if [ "$_rsha" = "0000000000000000000000000000000000000000" ]; then
            _range="$_lsha"
        else
            _range="${_rsha}..${_lsha}"
        fi

        _bad=$(git log --format="%H  author: %an <%ae>  committer: %cn <%ce>" \
                "$_range" 2>/dev/null \
            | grep -i "$_P")

        if [ -n "$_bad" ]; then
            echo "ERROR: Pushed commits contain a restricted identifier in author/committer identity:"
            printf '%s\n' "$_bad" | while IFS= read -r _entry; do
                printf '  %s\n' "$_entry"
            done
            echo ""
            echo "Fix the identity and rewrite history before pushing:"
            echo '  git config user.name  "<your-name>"'
            echo '  git config user.email "<your-email>"'
            echo "  git rebase -i <base-sha>"
            _FAILED=1
        fi
    fi

done

exit $_FAILED
