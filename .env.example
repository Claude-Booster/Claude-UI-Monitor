# LLM keys for Stagehand fallback (stagehand-fallback.js)
# Priority: ANTHROPIC_API_KEY → GROQ_API_KEY → OPENAI_API_KEY → BROWSERBASE_API_KEY
# At least one is required for the AI browser fallback feature.
# Free options: GROQ (https://console.groq.com) or OPENAI (https://platform.openai.com)

# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Figma integration (figma-baseline.js, figma-token-check.js, Figma MCP server)
# Get token: Figma → Settings → Security → Personal access tokens (scope: file_content:read)
# File key:  the alphanumeric ID in your Figma URL → figma.com/design/<FILE_KEY>/...
# FIGMA_ACCESS_TOKEN=
# FIGMA_FILE_KEY=
